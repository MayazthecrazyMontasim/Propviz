# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://propviz:propviz@localhost:5432/propviz

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Storage (AWS S3 or Cloudflare R2) ────────────────────────────────────────
STORAGE_BUCKET=propviz-assets
STORAGE_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
# For Cloudflare R2 only:
STORAGE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
CDN_BASE_URL=https://cdn.yourdomain.com

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-7

# ── ElevenLabs ────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Runway Gen-4 ─────────────────────────────────────────────────────────────
RUNWAY_API_KEY=your_runway_key
RUNWAY_VIDEO_DURATION=5

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_ORIGINS=["http://localhost:3000"]
MAX_UPLOAD_SIZE_MB=50
